# Local development only. Do not use these defaults for a deployed service.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://reed_dev:reed_local_only@127.0.0.1:55432/reed_dev
AUTH_PROVIDER=development

# Set AUTH_PROVIDER=supabase only after configuring a real project and SMS provider.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# Server only. Optional; enables durable provider identity deletion.
# SUPABASE_SERVICE_ROLE_KEY=

# Облачные фото: постоянный закрытый каталог (обязателен в production).
# CLOUD_STORAGE_PATH=/absolute/private/reed-cloud
# Опциональная доставка APNs. Все поля задаются вместе; ключ вне репозитория.
# APNS_KEY_PATH=/absolute/private/AuthKey.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=dev.dunchekk.reed
# APNS_SANDBOX=true
